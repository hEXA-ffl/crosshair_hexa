        act_show.triggered.connect(self._restore)
        act_toggle = QAction("Toggle crosshair", self)
        act_toggle.triggered.connect(self.toggle_overlay)
        act_quit = QAction("Quit", self)
        act_quit.triggered.connect(self.quit_app)
