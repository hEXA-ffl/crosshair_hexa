def safe_filename(name):
    s = re.sub(r"[^\w\-. ]+", "_", name, flags=re.UNICODE).strip()
    return s or "preset"


def screen_at(index):
    screens = QGuiApplication.screens()
    if 0 <= index < len(screens):
        return screens[index]
    return QGuiApplication.primaryScreen()


def screen_pixel_size(index=0):
    scr = screen_at(index)
    g = scr.geometry()
    dpr = scr.devicePixelRatio()
    return int(round(g.width() * dpr)), int(round(g.height() * dpr))


def blank_image(width, height):
    img = QImage(width, height, QImage.Format.Format_ARGB32)
    img.fill(Qt.GlobalColor.transparent)
    return img


def image_to_base64(img):
    ba = QByteArray()
    buf = QBuffer(ba)
    buf.open(QIODevice.OpenModeFlag.WriteOnly)
    img.save(buf, "PNG")
    buf.close()
    return bytes(ba.toBase64()).decode("ascii")


def image_from_base64(text):
    ba = QByteArray.fromBase64(QByteArray(text.encode("ascii")))
    img = QImage.fromData(ba, "PNG")
    if img.isNull():
        return None
    return img.convertToFormat(QImage.Format.Format_ARGB32)


def image_to_png_bytes(img):
    ba = QByteArray()
    buf = QBuffer(ba)
    buf.open(QIODevice.OpenModeFlag.WriteOnly)
    img.save(buf, "PNG")
    buf.close()
    return ba


def image_from_png_bytes(ba):
    img = QImage.fromData(ba, "PNG")
    return img.convertToFormat(QImage.Format.Format_ARGB32)


def load_frames(path):
    """Decode an image file into (frames, delays_ms). Works for plain
    images (single frame, delay 0) and animated GIF/WebP (one entry per
    frame, delay taken from the file, falling back to 80ms)."""
    reader = QImageReader(path)
    reader.setAutoTransform(True)
    frames = []
    delays = []
    img = reader.read()
    if img.isNull():
        img = QImage(path)
        if img.isNull():
            return [], []
        return [img.convertToFormat(QImage.Format.Format_ARGB32)], [0]
    frames.append(img.convertToFormat(QImage.Format.Format_ARGB32))
    d = reader.nextImageDelay()
    delays.append(d if d > 0 else 80)
    while reader.canRead() and len(frames) < 500:
        img = reader.read()
        if img.isNull():
            break
        frames.append(img.convertToFormat(QImage.Format.Format_ARGB32))
        d = reader.nextImageDelay()
        delays.append(d if d > 0 else 80)
    if len(frames) == 1:
        delays = [0]
    return frames, delays


def bresenham(x0, y0, x1, y1):
    pts = []
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        pts.append((x0, y0))
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy
            x0 += sx
        if e2 <= dx:
            err += dx
            y0 += sy
    return pts


def rect_points(x0, y0, x1, y1, filled):
    left, right = sorted((x0, x1))
    top, bottom = sorted((y0, y1))
    if filled:
        return {(x, y) for y in range(top, bottom + 1) for x in range(left, right + 1)}
    pts = set()
    for x in range(left, right + 1):
        pts.add((x, top))
        pts.add((x, bottom))
    for y in range(top, bottom + 1):
        pts.add((left, y))
        pts.add((right, y))
    return pts


def ellipse_points(x0, y0, x1, y1, filled):
    left, right = sorted((x0, x1))
    top, bottom = sorted((y0, y1))
    cx, cy = (left + right) / 2.0, (top + bottom) / 2.0
    rx, ry = max((right - left) / 2.0, 0.5), max((bottom - top) / 2.0, 0.5)
    inside = set()
    for y in range(top, bottom + 1):
        for x in range(left, right + 1):
            dx, dy = (x - cx) / rx, (y - cy) / ry
            if dx * dx + dy * dy <= 1.0:
                inside.add((x, y))
    if filled:
        return inside
    return {(x, y) for (x, y) in inside
            if any((x + a, y + b) not in inside for a, b in ((1, 0), (-1, 0), (0, 1), (0, -1)))}


