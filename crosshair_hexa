    def _final_color(self):
        r, g, b = self.r, self.g, self.b
        gray = 0.299 * r + 0.587 * g + 0.114 * b
        t = self.sat / 255.0
        fr = int(round(max(0, min(255, gray + (r - gray) * t))))
        fg = int(round(max(0, min(255, gray + (g - gray) * t))))
        fb = int(round(max(0, min(255, gray + (b - gray) * t))))
        return QColor(fr, fg, fb, self.a)

    def _set_rgb(self, r, g, b):
