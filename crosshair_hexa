    def _on_channel(self, key, val):
        if self._lock:
            return
        setattr(self, key, val)
        self._refresh()
        self.colorChanged.emit(self._final_color())

    def _on_hex(self):
        t = self.hexedit.text().strip().lstrip("#")
        try:
            if len(t) == 6:
                t += "ff"
            r, g, b, a = (int(t[i:i + 2], 16) for i in (0, 2, 4, 6))
            self.set_color(QColor(r, g, b, a))
