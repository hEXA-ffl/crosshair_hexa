        self.sat = 255
        self._refresh()
        self.colorChanged.emit(self._final_color())

    def _refresh(self):
        self._lock = True
        for key, val in (("r", self.r), ("g", self.g), ("b", self.b),
                         ("sat", self.sat), ("a", self.a)):
            self.sliders[key].setValue(val)
            self.value_labels[key].setText(str(val))
