        menu.addAction(act_toggle)
        menu.addSeparator()
        menu.addAction(act_quit)
        self.tray.setContextMenu(menu)
        self.tray.activated.connect(
            lambda r: self._restore() if r == QSystemTrayIcon.ActivationReason.Trigger else None)
        self.tray.setToolTip(APP_NAME)
        self.tray.show()

    def _restore(self):
        self.showNormal()
        self.raise_()
        self.activateWindow()

    def refresh_list(self, select_name=None):
        current = select_name or (self.current_preset().name if self.current_preset() else None)
        self.list.blockSignals(True)
        self.list.clear()
        for p in self.presets:
            self.list.addItem(QListWidgetItem(QIcon(p.thumbnail()), p.name))
        self.list.blockSignals(False)
        row = 0
        if current:
            for i, p in enumerate(self.presets):
                if p.name == current:
                    row = i
                    break
        if self.presets:
            self.list.setCurrentRow(row)
            self._on_select(row)

    def current_preset(self):
        i = self.list.currentRow()
        if 0 <= i < len(self.presets):
            return self.presets[i]
        return None

    def _on_select(self, _):
        p = self.current_preset()
        self.title.setText(p.name if p else "-")
        self.preview.set_preset(p)
        if p:
            self.settings["last_preset"] = p.name
            save_settings(self.settings)
            if self.running:
                self.overlay.show_preset(p, self.screen_combo.currentIndex())

    def _select_last(self):
        name = self.settings.get("last_preset")
        if name:
            for i, p in enumerate(self.presets):
                if p.name == name:
                    self.list.setCurrentRow(i)
                    return
        if self.presets:
            self.list.setCurrentRow(0)

    def new_preset(self):
        name, ok = QInputDialog.getText(self, "New preset", "Name:")
        if not ok or not name.strip():
            return
        w, h = screen_pixel_size(self.screen_combo.currentIndex())
        p = Preset(name.strip(), width=w, height=h)
        p.save()
        self.presets = load_presets()
        self.refresh_list(p.name)
        self.open_editor()

    def duplicate_preset(self):
        src = self.current_preset()
        if not src:
            return
        name, ok = QInputDialog.getText(self, "Duplicate preset", "Name:", text=src.name + " copy")
        if not ok or not name.strip():
            return
        p = Preset(name.strip(), image=src.image.copy())
        p.save()
        self.presets = load_presets()
        self.refresh_list(p.name)

    def rename_preset(self):
        p = self.current_preset()
        if not p:
            return
        name, ok = QInputDialog.getText(self, "Rename preset", "New name:", text=p.name)
        if not ok or not name.strip():
            return
        p.delete_file()
        p.name = name.strip()
        p.save()
        self.presets = load_presets()
        self.refresh_list(p.name)

    def delete_preset(self):
        p = self.current_preset()
        if not p:
            return
        if QMessageBox.question(self, "Delete preset",
                                "Delete preset '%s'?" % p.name) != QMessageBox.StandardButton.Yes:
            return
        p.delete_file()
        self.presets = load_presets()
        if self.running and not self.presets:
            self.toggle_overlay()
        self.refresh_list()

    def toggle_overlay(self):
        p = self.current_preset()
        if self.running:
            self.overlay.stop()
            self.running = False
            self.btn_run.setText("Start crosshair")
        elif p:
            if not self.overlay._is_x11 and not self._wayland_warned:
                self._wayland_warned = True
                QMessageBox.information(
                    self, "Wayland session detected",
                    "This session is running under Wayland (%s).\n\n"
                    "On Wayland there is no equivalent of X11's window-manager "
                    "bypass hint, so a true exclusive fullscreen game (not "
                    "borderless/windowed) will still cover the overlay "
                    "completely - this is a compositor limitation, not a bug "
                    "in this app.\n\n"
                    "For the overlay to work over fullscreen games, either:\n"
                    "  - set the game to Borderless / Windowed Fullscreen, or\n"
                    "  - log out and choose the 'Plasma (X11)' session at the "
                    "login screen, where the bypass hint works."
                    % self.overlay._platform)
            self.overlay.show_preset(p, self.screen_combo.currentIndex())
            self.running = True
            self.btn_run.setText("Stop crosshair")

    def open_editor(self):
        p = self.current_preset()
        if not p:
            QMessageBox.information(self, "Editor", "Create a preset first.")
            return
        was_running = self.running
        if was_running:
            self.toggle_overlay()
        self.editor = Editor(p, self.screen_combo.currentIndex())
        self.editor.saved.connect(self._on_editor_saved)
        self.editor.closed.connect(lambda: self._on_editor_closed(was_running))
        self.editor.showFullScreen()

    def _on_editor_saved(self, preset):
        self.presets = load_presets()
        self.refresh_list(preset.name)

    def _on_editor_closed(self, restart):
        self.editor = None
        self.presets = load_presets()
        self.refresh_list()
        if restart:
            self.toggle_overlay()

    def _on_screen(self, idx):
        self.settings["screen"] = idx
        save_settings(self.settings)
        if self.running:
            self.overlay.show_preset(self.current_preset(), idx)

    def _on_autostart(self, v):
        self.settings["autostart"] = v
        save_settings(self.settings)
        set_autostart(v)

    def _on_start_overlay(self, v):
        self.settings["start_overlay"] = v
        save_settings(self.settings)

    def quit_app(self):
        self.overlay.stop()
        if self.tray:
            self.tray.hide()
        QApplication.quit()

    def closeEvent(self, e):
        if self.tray is not None:
            e.ignore()
            self.hide()
            self.tray.showMessage(APP_NAME, "Minimized to tray. The crosshair keeps running.",
                                  QSystemTrayIcon.MessageIcon.Information, 2500)
        else:
            self.quit_app()
            e.accept()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setApplicationDisplayName(APP_NAME)
    app.setWindowIcon(make_app_icon())
    app.setQuitOnLastWindowClosed(False)
    app.setStyleSheet(QSS)

    win = MainWindow()
    args = sys.argv[1:]
    if "--start" in args or win.settings.get("start_overlay"):
        win.toggle_overlay()
    if not ("--tray" in args and win.tray is not None):
        win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

