class Layer:

    def __init__(self, name, frames, delays, pos=None, scale=1.0, opacity=255):
        self.name = name
        self.frames = frames
        self.delays = delays
        self.pos = pos if pos is not None else QPoint(0, 0)
        self.scale = scale
        self.opacity = opacity
        self.frame_index = 0
        self._elapsed = 0

    @property
    def is_animated(self):
        return len(self.frames) > 1

    def copy(self):
        l = Layer(self.name, self.frames, self.delays, QPoint(self.pos), self.scale, self.opacity)
        l.frame_index = self.frame_index
        return l

    def base_frame(self, index=None):
        i = self.frame_index if index is None else index
        return self.frames[i % len(self.frames)]

    def scaled_frame(self, index=None):
        img = self.base_frame(index)
        w = max(1, int(round(img.width() * self.scale)))
        h = max(1, int(round(img.height() * self.scale)))
        if (w, h) == (img.width(), img.height()):
            return img
        return img.scaled(w, h, Qt.AspectRatioMode.IgnoreAspectRatio,
                          Qt.TransformationMode.SmoothTransformation)

    def advance(self, dt_ms):
        if not self.is_animated:
            return False
        self._elapsed += dt_ms
        changed = False
        guard = 0
        while self._elapsed >= self.delays[self.frame_index] and guard < 8:
            d = self.delays[self.frame_index] or 80
            self._elapsed -= d
            self.frame_index = (self.frame_index + 1) % len(self.frames)
            changed = True
            guard += 1
        return changed

    def to_dict(self):
        return {"name": self.name, "pos": [self.pos.x(), self.pos.y()],
                "scale": self.scale, "opacity": self.opacity,
                "delays": list(self.delays),
                "frames": [image_to_base64(f) for f in self.frames]}

    @staticmethod
    def from_dict(d):
        frames = []
        for b64 in d.get("frames", []):
            img = image_from_base64(b64)
            if img is not None:
                frames.append(img)
        if not frames:
            return None
        delays = d.get("delays") or []
        if len(delays) != len(frames):
            delays = (list(delays) + [80] * len(frames))[:len(frames)]
        pos = d.get("pos", [0, 0])
        return Layer(d.get("name", "layer"), frames, delays,
                    pos=QPoint(int(pos[0]), int(pos[1])),
                    scale=float(d.get("scale", 1.0)),
                    opacity=int(d.get("opacity", 255)))


class Preset:
    def __init__(self, name, image=None, width=None, height=None, layers=None):
        self.name = name
        if image is None:
            if width is None or height is None:
                width, height = screen_pixel_size(0)
            image = blank_image(width, height)
        self.image = image
        self.layers = layers if layers is not None else []

    @property
    def width(self):
        return self.image.width()

    @property
    def height(self):
        return self.image.height()

    @property
    def path(self):
        return PRESETS_DIR / (safe_filename(self.name) + ".json")

    def copy(self):
        return Preset(self.name, image=self.image.copy(),
                      layers=[l.copy() for l in self.layers])

    def composite_image(self):

        if not self.layers:
            return self.image
        img = self.image.copy()
        p = QPainter(img)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        for layer in self.layers:
            p.setOpacity(layer.opacity / 255.0)
            p.drawImage(layer.pos, layer.scaled_frame())
        p.end()
        return img

    def to_dict(self):
        d = {"version": 3, "name": self.name, "width": self.width,
             "height": self.height, "png": image_to_base64(self.image)}
        if self.layers:
            d["layers"] = [l.to_dict() for l in self.layers]
        return d

    @staticmethod
    def from_dict(d):
        name = d.get("name", "preset")
        if "png" in d:
            img = image_from_base64(d["png"])
            if img is None:
                img = blank_image(*screen_pixel_size(0))
            preset = Preset(name, image=img)
        else:
            size = int(d.get("size", 65))
            img = blank_image(size, size)
            for key, hexcol in d.get("pixels", {}).items():
                try:
                    x, y = (int(v) for v in key.split(","))
                except ValueError:
                    continue
                if 0 <= x < size and 0 <= y < size:
                    h = hexcol.lstrip("#")
                    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
                    a = int(h[6:8], 16) if len(h) >= 8 else 255
                    img.setPixelColor(x, y, QColor(r, g, b, a))
            preset = Preset(name, image=img)
        layers = []
        for ld in d.get("layers", []):
            try:
                layer = Layer.from_dict(ld)
            except Exception:
                layer = None
            if layer is not None:
                layers.append(layer)
        preset.layers = layers
        return preset

    def save(self):
        PRESETS_DIR.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.to_dict(), ensure_ascii=False), encoding="utf-8")
        os.replace(tmp, self.path)

    def delete_file(self):
        try:
            self.path.unlink()
        except FileNotFoundError:
            pass

    def content_rect(self):
        if getattr(self, "_crect", None) is not None:
            return QRect(self._crect)
        img = self.composite_image()
        w, h = img.width(), img.height()
        k = max(1, int(math.ceil(max(w, h) / 220.0)))
        small = img.scaled(max(1, w // k), max(1, h // k),
                           Qt.AspectRatioMode.IgnoreAspectRatio,
                           Qt.TransformationMode.SmoothTransformation)
        sw, sh = small.width(), small.height()
        minx, miny, maxx, maxy = sw, sh, -1, -1
        try:
            ptr = small.bits()
            ptr.setsize(small.sizeInBytes())
            mv = memoryview(ptr).cast("I")
            stride = small.bytesPerLine() // 4
            for y in range(sh):
                row = y * stride
                for x in range(sw):
                    if mv[row + x] >> 24:
                        if x < minx:
                            minx = x
                        if x > maxx:
                            maxx = x
                        if y < miny:
                            miny = y
                        if y > maxy:
                            maxy = y
        except Exception:
            self._crect = QRect(0, 0, w, h)
            return QRect(self._crect)
        if maxx < 0:
            self._crect = QRect(0, 0, w, h)
        else:
            r = QRect(minx * k - k, miny * k - k, (maxx - minx + 3) * k, (maxy - miny + 3) * k)
            self._crect = r.intersected(QRect(0, 0, w, h))
        return QRect(self._crect)

    def thumbnail(self, box=44):
        pm = QPixmap(box, box)
        pm.fill(Qt.GlobalColor.transparent)
        src = self.composite_image()
        r = self.content_rect()
        pad = max(4, max(r.width(), r.height()) // 12)
        r = r.adjusted(-pad, -pad, pad, pad).intersected(QRect(0, 0, src.width(), src.height()))
        scale = min(box / max(r.width(), 1), box / max(r.height(), 1))
        w = max(1, int(r.width() * scale))
        h = max(1, int(r.height() * scale))
        p = QPainter(pm)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, scale < 1)
        p.drawImage(QRect((box - w) // 2, (box - h) // 2, w, h), src, r)
        p.end()
        return pm


def load_presets():
    PRESETS_DIR.mkdir(parents=True, exist_ok=True)
    out = []
    for f in sorted(PRESETS_DIR.glob("*.json")):
        try:
            out.append(Preset.from_dict(json.loads(f.read_text(encoding="utf-8"))))
        except Exception as e:
            print("Failed to read %s: %s" % (f, e), file=sys.stderr)
    return out


def create_default_presets():
    w, h = screen_pixel_size(0)
    cx, cy = w // 2, h // 2
    green = QColor(0, 255, 0, 255)
    cyan = QColor(61, 174, 233, 255)

    dot = Preset("Dot")
    for dx in (-1, 0, 1):
        for dy in (-1, 0, 1):
            dot.image.setPixelColor(cx + dx, cy + dy, green)

    cross = Preset("Cross")
    for i in range(4, 13):
        cross.image.setPixelColor(cx + i, cy, green)
        cross.image.setPixelColor(cx - i, cy, green)
        cross.image.setPixelColor(cx, cy + i, green)
        cross.image.setPixelColor(cx, cy - i, green)

    tcross = Preset("T-shape")
    for i in range(3, 14):
        tcross.image.setPixelColor(cx + i, cy, cyan)
        tcross.image.setPixelColor(cx - i, cy, cyan)
        tcross.image.setPixelColor(cx, cy + i, cyan)
    tcross.image.setPixelColor(cx, cy, cyan)

    for p in (dot, cross, tcross):
        p.save()


def load_settings():
    defaults = {"last_preset": "", "start_overlay": False, "autostart": False,
                "screen": 0, "bypass_wm": True}
    try:
        defaults.update(json.loads(SETTINGS_FILE.read_text(encoding="utf-8")))
    except Exception:
        pass
    return defaults


def save_settings(s):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    SETTINGS_FILE.write_text(json.dumps(s, ensure_ascii=False, indent=1), encoding="utf-8")


def set_autostart(enabled):
    AUTOSTART_FILE.parent.mkdir(parents=True, exist_ok=True)
    if enabled:
        script = Path(__file__).resolve()
        AUTOSTART_FILE.write_text(
            "[Desktop Entry]\nType=Application\nName=CrosshairX\n"
            'Exec="%s" "%s" --tray --start\n'
            "Icon=applications-games\nTerminal=false\nX-GNOME-Autostart-enabled=true\n"
            % (sys.executable, script), encoding="utf-8")
    else:
        try:
            AUTOSTART_FILE.unlink()
        except FileNotFoundError:
            pass


class Overlay(QWidget):
    def __init__(self, bypass_wm=True):
        super().__init__(None)
        self._platform = QGuiApplication.platformName()
        self._is_x11 = self._platform == "xcb"
        flags = (Qt.WindowType.FramelessWindowHint
                 | Qt.WindowType.WindowStaysOnTopHint
                 | Qt.WindowType.Tool
                 | Qt.WindowType.WindowTransparentForInput
                 | Qt.WindowType.WindowDoesNotAcceptFocus)
        if self._is_x11:
            flags |= Qt.WindowType.X11BypassWindowManagerHint
        self.setWindowFlags(flags)
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
        self.setAttribute(Qt.WidgetAttribute.WA_TransparentForMouseEvents)
        self.setAttribute(Qt.WidgetAttribute.WA_ShowWithoutActivating)
        self.setWindowTitle("CrosshairX Overlay")
        self.preset = None
        self._wmctrl = shutil.which("wmctrl")
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._keep_on_top)
        self._timer.setInterval(400)
        self._anim_timer = QTimer(self)
        self._anim_timer.setInterval(33)
        self._anim_timer.timeout.connect(self._advance_layers)

    def _advance_layers(self):
        if self.preset is None:
            return
        changed = False
        for layer in self.preset.layers:
            if layer.advance(self._anim_timer.interval()):
                changed = True
        if changed:
            self.update()

    def _keep_on_top(self):
        if not self.isVisible():
            return
        self.raise_()
        if self._wmctrl and self._is_x11:
            try:
                subprocess.Popen(
                    ["wmctrl", "-r", "CrosshairX Overlay", "-b", "add,above,sticky"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def show_preset(self, preset, screen_index=0):
        if preset is None:
            return
        self.preset = preset
        self.setGeometry(screen_at(screen_index).geometry())
        self.show()
        self.raise_()
        self._timer.start()
        if any(l.is_animated for l in preset.layers):
            self._anim_timer.start()
        else:
            self._anim_timer.stop()
        self.update()

    def stop(self):
        self._timer.stop()
        self._anim_timer.stop()
        self.hide()

    def paintEvent(self, _):
        if self.preset is None:
            return
        dpr = self.devicePixelRatioF()
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, False)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, False)
        p.scale(1.0 / dpr, 1.0 / dpr)
        w = int(round(self.width() * dpr))
        h = int(round(self.height() * dpr))
        img = self.preset.image
        ox = (w - img.width()) // 2
        oy = (h - img.height()) // 2
        p.drawImage(QPoint(ox, oy), img)
        if self.preset.layers:
            p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
            for layer in self.preset.layers:
                p.setOpacity(layer.opacity / 255.0)
                p.drawImage(QPoint(ox + layer.pos.x(), oy + layer.pos.y()), layer.scaled_frame())
            p.setOpacity(1.0)
        p.end()


class ColorPicker(QWidget):
    colorChanged = pyqtSignal(QColor)

    def __init__(self):
        super().__init__()
        self.r = 0
        self.g = 255
        self.b = 0
        self.sat = 255
        self.a = 255
        self._lock = False
        self.sliders = {}
        self.value_labels = {}

        lay = QVBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(14)

        for key, title, maxval, default in (
                ("r", "R", 255, self.r), ("g", "G", 255, self.g),
                ("b", "B", 255, self.b), ("sat", "Saturation", 255, self.sat),
                ("a", "Alpha", 255, self.a)):
            block = QVBoxLayout()
            block.setSpacing(3)
            head = QHBoxLayout()
            lbl = QLabel(title)
            val = QLabel(str(default))
            val.setObjectName("Hint")
            head.addWidget(lbl)
            head.addStretch(1)
            head.addWidget(val)
            block.addLayout(head)
            sld = QSlider(Qt.Orientation.Horizontal)
