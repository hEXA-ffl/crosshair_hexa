    def _install_shortcuts(self):
        for keys, fn in (("Ctrl+Z", self.undo), ("Ctrl+Shift+Z", self.redo),
                         ("Ctrl+Y", self.redo), ("Ctrl+S", self.save),
                         ("Esc", self.close), ("Ctrl+0", self.center_canvas),
                         ("Ctrl+H", self.toggle_panels)):
            sc = QShortcut(QKeySequence(keys), self)
            sc.activated.connect(fn)

    def toggle_panels(self):
        visible = not self.top_panel.isVisible()
        self.top_panel.setVisible(visible)
        self.tools_panel.setVisible(visible)
        self.status.setVisible(visible)
        self.update()

    def set_tool(self, key):
        self.tool = key
        for k, b in self.tool_buttons.items():
            b.setChecked(k == key)

    def _on_color(self, c):
        self.color = QColor(c)

    def _update_canvas_label(self):
        sw, sh = screen_pixel_size(self.screen_index)
        text = "%d x %d px" % (self.image.width(), self.image.height())
        if (self.image.width(), self.image.height()) != (sw, sh):
            text += "\nscreen is %d x %d" % (sw, sh)
        self.canvas_label.setText(text)

    def _dpr(self):
        return self.devicePixelRatioF()

    def _phys_size(self):
        dpr = self._dpr()
        return int(round(self.width() * dpr)), int(round(self.height() * dpr))

    def center_canvas(self):
        self.zoom = 1
        self.zoom_spin.blockSignals(True)
        self.zoom_spin.setValue(1)
        self.zoom_spin.blockSignals(False)
        w, h = self._phys_size()
        self.ox = (w - self.image.width()) // 2
        self.oy = (h - self.image.height()) // 2
        self.update()

    def _on_zoom_spin(self, v):
        w, h = self._phys_size()
        self._set_zoom(v, w // 2, h // 2)

    def _set_zoom(self, new_zoom, ax, ay):
        new_zoom = max(1, min(40, int(new_zoom)))
        if new_zoom == self.zoom:
            return
        cx = (ax - self.ox) / self.zoom
        cy = (ay - self.oy) / self.zoom
        self.zoom = new_zoom
        self.ox = int(round(ax - cx * new_zoom))
        self.oy = int(round(ay - cy * new_zoom))
        self.zoom_spin.blockSignals(True)
        self.zoom_spin.setValue(new_zoom)
        self.zoom_spin.blockSignals(False)
        self.update()

    def _to_canvas(self, pos):
        dpr = self._dpr()
        x = math.floor((pos.x() * dpr - self.ox) / self.zoom)
        y = math.floor((pos.y() * dpr - self.oy) / self.zoom)
        return QPoint(int(x), int(y))

    def _in_canvas(self, p):
        return 0 <= p.x() < self.image.width() and 0 <= p.y() < self.image.height()

    def _push_undo(self):
        self.undo_stack.append(image_to_png_bytes(self.image))
        if len(self.undo_stack) > 40:
            self.undo_stack.pop(0)
        self.redo_stack.clear()

    def undo(self):
        if not self.undo_stack:
            return
        self.redo_stack.append(image_to_png_bytes(self.image))
        self.image = image_from_png_bytes(self.undo_stack.pop())
        self.preset.image = self.image
        self.dirty = True
        self._update_canvas_label()
        self.update()

    def redo(self):
        if not self.redo_stack:
            return
        self.undo_stack.append(image_to_png_bytes(self.image))
        self.image = image_from_png_bytes(self.redo_stack.pop())
        self.preset.image = self.image
        self.dirty = True
        self._update_canvas_label()
        self.update()

    def clear(self):
        self._push_undo()
        self.image.fill(Qt.GlobalColor.transparent)
        self.dirty = True
        self.update()

    def resize_to_screen(self):
        sw, sh = screen_pixel_size(self.screen_index)
        if (self.image.width(), self.image.height()) == (sw, sh):
            return
        self._push_undo()
        dx = (sw - self.image.width()) // 2
        dy = (sh - self.image.height()) // 2
        img = blank_image(sw, sh)
        p = QPainter(img)
        p.drawImage(QPoint(dx, dy), self.image)
        p.end()
        self.image = img
        self.preset.image = img
        for layer in self.layers:
            layer.pos = QPoint(layer.pos.x() + dx, layer.pos.y() + dy)
        self.dirty = True
        self._update_canvas_label()
        self.center_canvas()

    def _set_layer_controls_enabled(self, enabled):
        for w in (self.layer_scale_spin, self.layer_opacity_slider):
            w.setEnabled(enabled)

    def refresh_layer_list(self, select_layer=None):
        self.layer_list.blockSignals(True)
        self.layer_list.clear()
        for l in self.layers:
            icon = QIcon(QPixmap.fromImage(l.base_frame()).scaled(
                32, 32, Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation))
            label = l.name + ("  (gif)" if l.is_animated else "")
            self.layer_list.addItem(QListWidgetItem(icon, label))
        self.layer_list.blockSignals(False)
        target = select_layer if select_layer is not None else self.active_layer
        row = self.layers.index(target) if target in self.layers else -1
        if row < 0 and self.layers:
            row = len(self.layers) - 1
        if row >= 0:
            self.layer_list.setCurrentRow(row)
        else:
            self.active_layer = None
            self._set_layer_controls_enabled(False)

    def _on_layer_select(self, row):
        if 0 <= row < len(self.layers):
            self.active_layer = self.layers[row]
            self.layer_scale_spin.blockSignals(True)
            self.layer_scale_spin.setValue(int(round(self.active_layer.scale * 100)))
            self.layer_scale_spin.blockSignals(False)
            self.layer_opacity_slider.blockSignals(True)
            self.layer_opacity_slider.setValue(self.active_layer.opacity)
            self.layer_opacity_slider.blockSignals(False)
            self._set_layer_controls_enabled(True)
        else:
            self.active_layer = None
            self._set_layer_controls_enabled(False)
        self.update()

    def _on_layer_scale(self, percent):
        if self.active_layer is None:
            return
        self.active_layer.scale = max(0.01, percent / 100.0)
        self.dirty = True
        self.update()

    def _on_layer_opacity(self, val):
        if self.active_layer is None:
            return
        self.active_layer.opacity = val
        self.dirty = True
        self.update()

    def move_layer_up(self):
        l = self.active_layer
        if l is None or l not in self.layers:
            return
        i = self.layers.index(l)
        if i + 1 < len(self.layers):
            self.layers[i], self.layers[i + 1] = self.layers[i + 1], self.layers[i]
            self.dirty = True
            self.refresh_layer_list(l)
            self.update()

    def move_layer_down(self):
        l = self.active_layer
        if l is None or l not in self.layers:
            return
        i = self.layers.index(l)
        if i > 0:
            self.layers[i - 1], self.layers[i] = self.layers[i], self.layers[i - 1]
            self.dirty = True
            self.refresh_layer_list(l)
            self.update()

    def delete_layer(self):
        l = self.active_layer
        if l is None or l not in self.layers:
            return
        self.layers.remove(l)
        self.active_layer = None
        self.dirty = True
        self.refresh_layer_list()
        self.update()

    def flatten_layer(self):
        l = self.active_layer
        if l is None or l not in self.layers:
            return
        self._push_undo()
        painter = QPainter(self.image)
        painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        painter.setOpacity(l.opacity / 255.0)
        painter.drawImage(l.pos, l.scaled_frame())
        painter.end()
        self.preset.image = self.image
        self.layers.remove(l)
        self.active_layer = None
        self.dirty = True
        self.refresh_layer_list()
        self._update_canvas_label()
        self.status.setText("Layer flattened onto the canvas.")
        self.update()

    def _layer_screen_rect(self, layer):
        dpr = self._dpr()
        f = layer.scaled_frame()
        left = (self.ox + layer.pos.x() * self.zoom) / dpr
        top = (self.oy + layer.pos.y() * self.zoom) / dpr
        right = (self.ox + (layer.pos.x() + f.width()) * self.zoom) / dpr
        bottom = (self.oy + (layer.pos.y() + f.height()) * self.zoom) / dpr
        return left, top, right, bottom

    def _layer_hit_test(self, pos):
        tol = 9.0
        for layer in reversed(self.layers):
            left, top, right, bottom = self._layer_screen_rect(layer)
            if abs(pos.x() - right) <= tol and abs(pos.y() - bottom) <= tol:
                return layer, True
            if left <= pos.x() <= right and top <= pos.y() <= bottom:
                return layer, False
        return None

    def _stamp(self, painter, x, y, color):
        w = self.thickness
        painter.fillRect(x - (w - 1) // 2, y - (w - 1) // 2, w, w, color)

    def _draw_points(self, points, erase=False):
        painter = QPainter(self.image)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing, False)
        painter.setCompositionMode(QPainter.CompositionMode.CompositionMode_Source)
        color = QColor(0, 0, 0, 0) if erase else self.color
        for (x, y) in points:
            self._stamp(painter, x, y, color)
        painter.end()
        self.preset.image = self.image
        self.dirty = True
        self.update()

    def _flood_fill(self, sx, sy):
        img = self.image
        w, h = img.width(), img.height()
        try:
            ptr = img.bits()
            ptr.setsize(img.sizeInBytes())
            mv = memoryview(ptr).cast("I")
        except Exception:
            return
        stride = img.bytesPerLine() // 4
        target = mv[sy * stride + sx]
        c = self.color
        new = (c.alpha() << 24) | (c.red() << 16) | (c.green() << 8) | c.blue()
        if target == new:
            return
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        stack = [(sx, sy)]
        while stack:
            x, y = stack.pop()
            row = y * stride
            if mv[row + x] != target:
                continue
            x0 = x
            while x0 > 0 and mv[row + x0 - 1] == target:
                x0 -= 1
            x1 = x
            while x1 < w - 1 and mv[row + x1 + 1] == target:
                x1 += 1
            for i in range(x0, x1 + 1):
                mv[row + i] = new
            for ny in (y - 1, y + 1):
                if 0 <= ny < h:
                    nrow = ny * stride
                    i = x0
                    while i <= x1:
                        if mv[nrow + i] == target:
                            stack.append((i, ny))
                            while i <= x1 and mv[nrow + i] == target:
                                i += 1
                        i += 1
        QApplication.restoreOverrideCursor()
        self.preset.image = self.image
        self.dirty = True
        self.update()

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.MiddleButton:
            self.panning = True
            self.pan_anchor = e.position()
            self.setCursor(Qt.CursorShape.ClosedHandCursor)
            return
        if self.tool == "move":
            if e.button() == Qt.MouseButton.LeftButton:
                hit = self._layer_hit_test(e.position())
                if hit is not None:
                    layer, on_handle = hit
                    if layer is not self.active_layer:
                        self.active_layer = layer
                        self.refresh_layer_list(layer)
                    if on_handle:
                        self.layer_resizing = True
                        self.layer_resize_start = e.position()
                        self.layer_resize_orig_scale = layer.scale
                    else:
                        self.layer_dragging = True
                        self.layer_drag_anchor = e.position()
                        self.layer_drag_orig_pos = QPoint(layer.pos)
            return
        p = self._to_canvas(e.position())
        if not self._in_canvas(p):
            return
        erase = e.button() == Qt.MouseButton.RightButton or self.tool == "eraser"
        if self.tool == "picker" and not erase:
            self.picker.set_color(self.image.pixelColor(p))
            return
        self._push_undo()
        if self.tool == "fill" and not erase:
            self._flood_fill(p.x(), p.y())
            return
        self.drag_start = p
        self.last_pt = p
        if self.tool in ("line", "rect", "ellipse"):
            self.snapshot = self.image.copy()
        self._draw_points([(p.x(), p.y())], erase)

    def mouseMoveEvent(self, e):
        if self.panning:
            dpr = self._dpr()
            d = e.position() - self.pan_anchor
            self.ox += int(round(d.x() * dpr))
            self.oy += int(round(d.y() * dpr))
            self.pan_anchor = e.position()
            self.update()
            return
        if self.tool == "move":
            dpr = self._dpr()
            pos = e.position()
            if self.layer_dragging and self.active_layer is not None:
                dx = (pos.x() - self.layer_drag_anchor.x()) * dpr / self.zoom
                dy = (pos.y() - self.layer_drag_anchor.y()) * dpr / self.zoom
                self.active_layer.pos = QPoint(
                    int(round(self.layer_drag_orig_pos.x() + dx)),
                    int(round(self.layer_drag_orig_pos.y() + dy)))
                self.dirty = True
                self.update()
            elif self.layer_resizing and self.active_layer is not None:
                layer = self.active_layer
                base = layer.base_frame()
                delta = pos.x() - self.layer_resize_start.x()
                orig_w_screen = base.width() * self.layer_resize_orig_scale * self.zoom / dpr
                new_w_screen = max(6.0, orig_w_screen + delta)
                new_scale = new_w_screen * dpr / (self.zoom * base.width())
                new_scale = max(0.05, min(8.0, new_scale))
                layer.scale = new_scale
                self.dirty = True
                self.layer_scale_spin.blockSignals(True)
                self.layer_scale_spin.setValue(int(round(new_scale * 100)))
                self.layer_scale_spin.blockSignals(False)
                self.update()
            else:
                hit = self._layer_hit_test(pos)
                if hit is not None:
                    layer, on_handle = hit
                    self.setCursor(Qt.CursorShape.SizeFDiagCursor if on_handle
                                   else Qt.CursorShape.OpenHandCursor)
                else:
                    self.unsetCursor()
            return
        p = self._to_canvas(e.position())
        self.hover = p if self._in_canvas(p) else None
        if self.drag_start is None:
            self._update_status(p)
            self.update()
            return
        erase = bool(e.buttons() & Qt.MouseButton.RightButton) or self.tool == "eraser"
        if self.tool in ("pencil", "eraser"):
            pts = bresenham(self.last_pt.x(), self.last_pt.y(), p.x(), p.y())
            self.last_pt = p
            self._draw_points(pts, erase)
        elif self.tool in ("line", "rect", "ellipse") and self.snapshot is not None:
            self.image = self.snapshot.copy()
            self.preset.image = self.image
            if self.tool == "line":
                pts = bresenham(self.drag_start.x(), self.drag_start.y(), p.x(), p.y())
            elif self.tool == "rect":
                pts = rect_points(self.drag_start.x(), self.drag_start.y(),
                                  p.x(), p.y(), self.fill_shapes)
            else:
                pts = ellipse_points(self.drag_start.x(), self.drag_start.y(),
                                     p.x(), p.y(), self.fill_shapes)
            self._draw_points(pts, erase)
        self._update_status(p)

    def mouseReleaseEvent(self, e):
        if e.button() == Qt.MouseButton.MiddleButton:
            self.panning = False
            self.unsetCursor()
            return
        if self.tool == "move":
            self.layer_dragging = False
            self.layer_resizing = False
            return
        self.drag_start = None
        self.snapshot = None
        self.last_pt = None

    def wheelEvent(self, e):
        pos = e.position().toPoint()
        if self._over_chrome(pos):
            self._forward_wheel_to_panel(e, pos)
            return
        dpr = self._dpr()
        step = 1 if e.angleDelta().y() > 0 else -1
        target = self.zoom + step if self.zoom < 8 else self.zoom + step * 2
        self._set_zoom(target, int(pos.x() * dpr), int(pos.y() * dpr))

    def _over_chrome(self, pos):
        for panel in (self.top_panel, self.tools_panel):
            if panel.isVisible() and panel.geometry().contains(pos):
                return True
        return False

    def _forward_wheel_to_panel(self, e, pos):
        child = self.childAt(pos)
        if isinstance(child, QSlider):
            return
        panel = self.tools_panel if self.tools_panel.geometry().contains(pos) else self.top_panel
        delta = 1 if e.angleDelta().y() > 0 else -1
        best, best_dist = None, None
        for sld in panel.findChildren(QSlider):
            if not sld.isVisible():
                continue
            top_left = sld.mapTo(self, QPoint(0, 0))
            center_y = top_left.y() + sld.height() // 2
            dist = abs(center_y - pos.y())
            if best_dist is None or dist < best_dist:
                best_dist, best = dist, sld
        if best is not None:
            step = best.singleStep() or 1
            best.setValue(max(best.minimum(), min(best.maximum(), best.value() + delta * step)))

    def _update_status(self, p):
        iw, ih = self.image.width(), self.image.height()
        dx = p.x() - iw / 2.0
        dy = p.y() - ih / 2.0
        self.status.setText(
            "canvas %d, %d    offset from screen center %+d, %+d    zoom %dx"
            % (p.x(), p.y(), int(round(dx)), int(round(dy)), self.zoom))

    def paintEvent(self, _):
        dpr = self._dpr()
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, False)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, False)
        p.fillRect(self.rect(), QColor(10, 15, 21, self.dim))
        p.scale(1.0 / dpr, 1.0 / dpr)

        w, h = self._phys_size()
        z = self.zoom
        iw, ih = self.image.width(), self.image.height()

        x0 = max(0, math.floor((0 - self.ox) / z))
        y0 = max(0, math.floor((0 - self.oy) / z))
        x1 = min(iw - 1, math.floor((w - self.ox) / z))
        y1 = min(ih - 1, math.floor((h - self.oy) / z))

        p.setPen(QColor(61, 174, 233, 60))
        cross_x = self.ox + (iw / 2.0) * z
        cross_y = self.oy + (ih / 2.0) * z
        p.drawLine(0, int(round(cross_y)), w, int(round(cross_y)))
        p.drawLine(int(round(cross_x)), 0, int(round(cross_x)), h)

        if x1 >= x0 and y1 >= y0:
            src = QRect(x0, y0, x1 - x0 + 1, y1 - y0 + 1)
            dst = QRect(self.ox + x0 * z, self.oy + y0 * z, src.width() * z, src.height() * z)
            p.drawImage(dst, self.image, src)

            if self.show_grid and z >= 6:
                p.setPen(QColor(255, 255, 255, 20))
                for i in range(src.width() + 1):
                    gx = dst.left() + i * z
                    p.drawLine(gx, dst.top(), gx, dst.bottom())
                for i in range(src.height() + 1):
                    gy = dst.top() + i * z
                    p.drawLine(dst.left(), gy, dst.right(), gy)

        p.setPen(QColor(61, 174, 233, 120))
        p.drawRect(QRect(self.ox - 1, self.oy - 1, iw * z + 1, ih * z + 1))

        for layer in self.layers:
            f = layer.scaled_frame()
            dst = QRect(self.ox + layer.pos.x() * z, self.oy + layer.pos.y() * z,
                       f.width() * z, f.height() * z)
            p.setOpacity(layer.opacity / 255.0)
            p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
            p.drawImage(dst, f)
            p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, False)
            p.setOpacity(1.0)

        if (self.tool == "move" and self.active_layer is not None
                and self.active_layer in self.layers):
            layer = self.active_layer
            f = layer.scaled_frame()
            dst = QRect(self.ox + layer.pos.x() * z, self.oy + layer.pos.y() * z,
                       f.width() * z, f.height() * z)
            pen = QPen(QColor(255, 255, 255, 230))
            pen.setStyle(Qt.PenStyle.DashLine)
            pen.setWidth(1)
            p.setPen(pen)
            p.setBrush(Qt.BrushStyle.NoBrush)
            p.drawRect(dst)
            hs = 9
            p.setPen(QColor(20, 20, 20))
            p.setBrush(QColor(255, 255, 255))
            p.drawRect(dst.right() - hs // 2, dst.bottom() - hs // 2, hs, hs)
            p.setBrush(Qt.BrushStyle.NoBrush)

        if self.hover is not None and self.tool != "move":
            t = self.thickness
            hx = self.ox + (self.hover.x() - (t - 1) // 2) * z
            hy = self.oy + (self.hover.y() - (t - 1) // 2) * z
            p.setPen(QColor(255, 255, 255, 190))
            p.drawRect(hx, hy, t * z, t * z)

        if not self.top_panel.isVisible():
            p.setPen(QColor(125, 143, 163))
            p.drawText(QRect(0, 16, w, 30), Qt.AlignmentFlag.AlignHCenter,
                       "Ctrl+H to show panels")
        p.end()

    def _apply_name(self):
        name = self.name_edit.text().strip() or "Untitled"
        self.preset.name = name
        return name

    def save(self):
        name = self._apply_name()
        old = PRESETS_DIR / (safe_filename(self.orig_name) + ".json")
        self.preset.save()
        if safe_filename(name) != safe_filename(self.orig_name):
            try:
                old.unlink()
            except FileNotFoundError:
                pass
        self.orig_name = name
        self.dirty = False
        self.status.setText("Saved to %s" % self.preset.path)
        self.saved.emit(self.preset.copy())

    def save_as(self):
        name, ok = QInputDialog.getText(self, "Save as", "New preset name:")
        if not ok or not name.strip():
            return
        self.name_edit.setText(name.strip())
        self.preset.name = name.strip()
        self.preset.save()
        self.orig_name = name.strip()
        self.dirty = False
        self.status.setText("Saved to %s" % self.preset.path)
        self.saved.emit(self.preset.copy())

    def load_dialog(self):
        presets = load_presets()
        if not presets:
            QMessageBox.information(self, "Load", "No saved presets yet.")
            return
        names = [p.name for p in presets]
        name, ok = QInputDialog.getItem(self, "Load preset", "Preset:", names, 0, False)
        if not ok:
            return
        chosen = presets[names.index(name)]
        self._push_undo()
        self.image = chosen.image.copy()
        self.layers = [l.copy() for l in chosen.layers]
        self.preset = Preset(chosen.name, image=self.image, layers=self.layers)
        self.active_layer = None
        self.name_edit.setText(chosen.name)
        self.orig_name = chosen.name
        self.dirty = False
        self._update_canvas_label()
        self.refresh_layer_list()
        self.center_canvas()

    def import_image(self):
        path, _ = QFileDialog.getOpenFileName(
            self, "Import image", str(Path.home()),
            "Images (*.png *.gif *.bmp *.webp *.jpg *.jpeg)")
        if not path:
            return
        frames, delays = load_frames(path)
        if not frames:
            QMessageBox.warning(self, "Import", "Could not open that file.")
            return
        cw, ch = self.image.width(), self.image.height()
        fw, fh = frames[0].width(), frames[0].height()
        scale = 1.0
        if fw > cw or fh > ch:
            scale = min(cw / fw, ch / fh, 1.0)
        base_name = Path(path).stem or "layer"
        existing = {l.name for l in self.layers}
        name, n = base_name, 2
        while name in existing:
            name = "%s %d" % (base_name, n)
            n += 1
        layer = Layer(name, frames, delays, scale=scale)
        layer.pos = QPoint(int(round((cw - fw * scale) / 2)), int(round((ch - fh * scale) / 2)))
        self.layers.append(layer)
        self.active_layer = layer
        self.dirty = True
        self.set_tool("move")
        self.refresh_layer_list(layer)
        kind = ("animated GIF (%d frames)" % len(frames)) if layer.is_animated else "image"
        self.status.setText("Imported %s as a new layer. Drag to move, "
                            "corner handle to resize." % kind)
        self.update()

    def closeEvent(self, e):
        if self.dirty:
            res = QMessageBox.question(
                self, "Close editor", "You have unsaved changes. Save them?",
                QMessageBox.StandardButton.Save | QMessageBox.StandardButton.Discard
                | QMessageBox.StandardButton.Cancel)
            if res == QMessageBox.StandardButton.Cancel:
                e.ignore()
                return
            if res == QMessageBox.StandardButton.Save:
                self.save()
        self.closed.emit()
        e.accept()


class PreviewBox(QFrame):
    def __init__(self):
        super().__init__()
        self.setObjectName("Panel")
        self.setMinimumHeight(240)
        self.preset = None
        self._timer = QTimer(self)
        self._timer.setInterval(60)
        self._timer.timeout.connect(self._tick)

    def set_preset(self, preset):
        self.preset = preset
        if preset is not None and any(l.is_animated for l in preset.layers):
            self._timer.start()
        else:
            self._timer.stop()
        self.update()

    def _tick(self):
        if self.preset is None:
            return
        changed = False
        for layer in self.preset.layers:
            if layer.advance(self._timer.interval()):
                changed = True
        if changed:
            self.update()

    def paintEvent(self, e):
        super().paintEvent(e)
        p = QPainter(self)
        r = self.rect().adjusted(10, 10, -10, -10)
        if self.preset is None:
            p.setPen(QColor(125, 143, 163))
            p.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter, "No preset selected")
            p.end()
            return
        img = self.preset.composite_image()
        scale = min(r.width() / img.width(), r.height() / img.height(), 1.0)
        w = max(1, int(img.width() * scale))
        h = max(1, int(img.height() * scale))
        frame = QRect(r.center().x() - w // 2, r.center().y() - h // 2, w, h)
        p.fillRect(frame, QColor(11, 17, 24))
        p.setPen(QColor(61, 174, 233, 40))
        p.drawLine(frame.left(), frame.center().y(), frame.right(), frame.center().y())
        p.drawLine(frame.center().x(), frame.top(), frame.center().x(), frame.bottom())
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)
        p.drawImage(frame, img)
        cr = self.preset.content_rect()
        marker = QRect(frame.left() + int(cr.left() * scale) - 3,
                       frame.top() + int(cr.top() * scale) - 3,
                       max(int(cr.width() * scale) + 6, 8),
                       max(int(cr.height() * scale) + 6, 8))
        p.setPen(QColor(255, 120, 120, 150))
        p.drawRect(marker)
        p.setPen(QColor(43, 60, 78))
        p.drawRect(frame)
        p.setPen(QColor(125, 143, 163))
        p.drawText(self.rect().adjusted(0, 0, -12, -6),
                   Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignBottom,
                   "%d x %d" % (img.width(), img.height()))
        p.end()


